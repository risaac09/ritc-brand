{
  "$meta": {
    "name": "Rhode Island Track Club brand tokens",
    "version": "1.5.0",
    "updated": "2026-09-12",
    "source": "Print-ready 2026 singlet file. Secondary values from the singlet colorway sheet and the Larana Studio outers lookbook.",
    "rule": "Hex is digital only. Never convert a hex value here to CMYK for print. Use the cmyk block."
  },
  "color": {
    "primary": {
      "babyOceanBlue": {
        "hex": "#A2C9CF",
        "rgb": [
          162,
          201,
          207
        ],
        "cmyk": [
          36,
          9,
          16,
          0
        ],
        "role": "fill",
        "textSafe": false,
        "note": "Fill and field color. Never set type in this color on white."
      },
      "deepNavy": {
        "hex": "#011E3D",
        "rgb": [
          1,
          30,
          61
        ],
        "cmyk": [
          99.6,
          83.8,
          39.2,
          57
        ],
        "role": "ground-and-text",
        "textSafe": true,
        "note": "The workhorse. Text on any light ground, ground for any light text."
      },
      "white": {
        "hex": "#FFFFFF",
        "rgb": [
          255,
          255,
          255
        ],
        "cmyk": [
          0,
          0,
          0,
          0
        ],
        "role": "ground-and-text",
        "textSafe": true
      }
    },
    "secondary": {
      "sand": {
        "hex": "#C6B79B",
        "rgb": [
          198,
          183,
          155
        ],
        "cmyk": null,
        "role": "fill",
        "textSafe": false,
        "scope": "outers",
        "note": "Warmups and the On Focus T. Screen-sampled, not verified against a print file. CMYK is a named gap."
      },
      "ebony": {
        "hex": "#1C1C1C",
        "rgb": [
          28,
          28,
          28
        ],
        "cmyk": null,
        "role": "ground-and-text",
        "textSafe": true,
        "scope": "outers",
        "note": "Screen-sampled, not verified against a print file. CMYK is a named gap."
      }
    },
    "semantic": {
      "$note": "Roles that depend on the ground are defined per layer, not as constants. Resolve them through layer.pairs, which now carries fieldMuted, rule, accent and accentText alongside frame/field. The scrim is the deliberate exception: a photo always gets a navy scrim regardless of layer.",
      "scrimFrom": "rgba(1, 30, 61, 0)",
      "scrimMid": "rgba(1, 30, 61, 0.45)",
      "scrimTo": "rgba(1, 30, 61, 0.88)",
      "edgeTint": "rgba(1, 30, 61, 0.35)"
    }
  },
  "contrast": {
    "method": "WCAG 2.1 relative luminance, computed 2026-09-12",
    "pass": [
      {
        "pair": "deepNavy on white",
        "ratio": 16.74
      },
      {
        "pair": "white on ebony",
        "ratio": 17.04
      },
      {
        "pair": "babyOceanBlue on ebony",
        "ratio": 9.57
      },
      {
        "pair": "babyOceanBlue on deepNavy",
        "ratio": 9.4
      },
      {
        "pair": "sand on ebony",
        "ratio": 8.64
      },
      {
        "pair": "deepNavy on sand",
        "ratio": 8.49
      },
      {
        "pair": "white on deepNavy",
        "ratio": 16.74
      }
    ],
    "fail": [
      {
        "pair": "white on sand",
        "ratio": 1.97,
        "verdict": "Never. Fill against fill."
      },
      {
        "pair": "babyOceanBlue on white",
        "ratio": 1.78,
        "verdict": "Never as text. Shape and fill only."
      },
      {
        "pair": "deepNavy on ebony",
        "ratio": 1.02,
        "verdict": "Never. Effectively invisible."
      }
    ]
  },
