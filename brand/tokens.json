  "layer": {
    "$note": "The warmups go over the singlet. Sand and Ebony frame; Baby Ocean Blue, Navy and White fill. Only two pairings separate at the boundary. The bottom band is deeper (frameWaist) because it holds the badge, which is an outer-layer element.",
    "frameBand": 56,
    "pairs": {
      "a": {
        "frame": "#C6B79B",
        "frameText": "#1C1C1C",
        "field": "#011E3D",
        "fieldText": "#FFFFFF",
        "boundaryContrast": 8.49,
        "label": "Sand frame, Navy field",
        "fieldMuted": "#A2C9CF",
        "fieldMutedContrast": 9.4,
        "rule": "#A2C9CF",
        "accent": "#A2C9CF",
        "accentText": "#011E3D",
        "accentVsField": 9.4,
        "accentTextOnAccent": 9.4
      },
      "b": {
        "frame": "#1C1C1C",
        "frameText": "#C6B79B",
        "field": "#A2C9CF",
        "fieldText": "#011E3D",
        "boundaryContrast": 9.57,
        "label": "Ebony frame, Baby Ocean Blue field",
        "fieldMuted": "rgba(1, 30, 61, 0.7)",
        "fieldMutedContrast": 4.7,
        "rule": "rgba(1, 30, 61, 0.7)",
        "accent": "#011E3D",
        "accentText": "#FFFFFF",
        "accentVsField": 9.4,
        "accentTextOnAccent": 16.74
      }
    },
    "illegalPairs": [
      {
        "frame": "#FFFFFF",
        "field": "#C6B79B",
        "boundaryContrast": 1.97
      },
      {
        "frame": "#C6B79B",
        "field": "#A2C9CF",
        "boundaryContrast": 1.11
      },
      {
        "frame": "#1C1C1C",
        "field": "#011E3D",
        "boundaryContrast": 1.02
      }
    ],
    "framePolicy": {
      "workout-announcement": "full",
      "event-promo": "full",
      "member-spotlight": "hem",
      "quote-card": "hem",
      "story": "hem",
      "race-recap": "none"
    },
    "frameWaist": 200,
    "onPhoto": {
      "$note": "A photo's scrim is always navy, so foreground roles over a photo revert to the layer A (on-navy) set regardless of the selected layer. Applied as .ritc-on-photo.",
      "fieldText": "#FFFFFF",
      "fieldMuted": "#A2C9CF",
      "rule": "#A2C9CF",
      "accent": "#A2C9CF",
      "accentText": "#011E3D"
    }
  },
  "mark": {
    "$note": "The 2020 badge's own colours. These are NOT part of the brand palette and must never be used as design colours. They are recorded so a template can reason about the badge on a ground.",
    "badgeField": "#0E5CC6",
    "badgeRope": "#F5E056",
    "badgeAnchor": "#FFFFFF",
    "outerElement": "rope",
    "boundaryContrastVsNavy": 12.5,
    "paletteConflict": "The 2020 badge is on a different colour system than the 2026 kit. Settled 2026-09-13: the badge is not redrawn. It is the club's real mark, maple leaf included, and the system carries it as it is. The yellow rope is the outermost element, so it separates on every ground.",
    "anchorMaxCleanPx": 120,
    "files": {
      "badge": "assets/logo/ritc-badge.png",
      "badgeSvg": "assets/logo/ritc-badge.svg",
      "badgeBw": "assets/logo/ritc-badge-bw.png",
      "anchorSvg": "assets/logo/ritc-anchor.svg",
      "anchorPng": "assets/logo/ritc-anchor.png"
    },
    "mapleLeaf": "Deliberate, part of the mark as drawn. Not a stock-template artifact."
